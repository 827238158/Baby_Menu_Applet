page {
  min-height: 100%;
  color: #1f2933;
  background: #f5f6f8;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  border: 0;
  border-radius: 0;
  background: transparent;
}

button::after {
  border: 0;
}

image {
  display: block;
}
