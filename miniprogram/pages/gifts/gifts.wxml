<view class="page" style="{{pageStyle}}">
  <view class="collection-shell-header">
    <view class="gift-header">
      <image
        wx:if="{{shop.headerBackgroundImage}}"
        class="gift-header-bg"
        src="{{shop.headerBackgroundImage}}"
        mode="aspectFill"
      ></image>
      <view class="gift-header-overlay"></view>
      <view class="gift-header-copy">
        <text class="gift-header-title">我的心愿夹</text>
        <text wx:if="{{isInitialLoading}}" class="gift-header-subtitle">正在同步{{collectionTitle}}…</text>
        <text wx:else class="gift-header-subtitle">已收藏 {{giftCount}} {{collectionSubtitleNoun}}</text>
      </view>
    </view>

    <view wx:if="{{!accessDenied}}" class="collection-segment-wrap">
      <view class="collection-segment" aria-role="tablist" aria-label="心愿夹分类">
        <view class="collection-segment-indicator {{activeCollection === 'decor' ? 'collection-segment-indicator-right' : ''}}"></view>
        <view
          class="collection-segment-item {{activeCollection === 'gift' ? 'collection-segment-item-active' : ''}}"
          data-collection="gift"
          bindtap="switchCollection"
          aria-role="tab"
          aria-selected="{{activeCollection === 'gift'}}"
        >礼品夹</view>
        <view
          class="collection-segment-item {{activeCollection === 'decor' ? 'collection-segment-item-active' : ''}}"
          data-collection="decor"
          bindtap="switchCollection"
          aria-role="tab"
          aria-selected="{{activeCollection === 'decor'}}"
        >装修好物</view>
      </view>
    </view>
  </view>

  <view wx:if="{{accessDenied}}" class="access-denied-state collection-body">
    <view class="access-denied-icon">!</view>
    <text class="access-denied-title">仅限受邀用户使用心愿夹</text>
    <text class="access-denied-description">当前微信账号不在授权名单中，无法查看或编辑收藏内容。</text>
    <button class="access-denied-button" bindtap="backToMenu">返回菜单</button>
  </view>

  <scroll-view
    wx:if="{{!accessDenied}}"
    class="collection-list-scroll"
    scroll-y="{{true}}"
    scroll-top="{{listScrollTop}}"
    enable-back-to-top="{{true}}"
    lower-threshold="120"
    bindscroll="handleListScroll"
    bindscrolltolower="loadMoreGifts"
  >
    <view class="collection-content">
      <view
        wx:if="{{isInitialLoading}}"
        class="gift-skeleton-list"
        aria-label="正在加载{{collectionTitle}}"
        aria-busy="true"
      >
        <view
          class="gift-card gift-skeleton-card"
          wx:for="{{loadingSkeletons}}"
          wx:key="*this"
        >
          <view class="gift-skeleton-image gift-skeleton-block"></view>
          <view class="gift-skeleton-info">
            <view class="gift-skeleton-title gift-skeleton-block"></view>
            <view class="gift-skeleton-line gift-skeleton-line-long gift-skeleton-block"></view>
            <view class="gift-skeleton-line gift-skeleton-line-short gift-skeleton-block"></view>
          </view>
        </view>
      </view>

      <view wx:if="{{!isInitialLoading && gifts.length}}" class="gift-list">
        <collection-item-card
          wx:for="{{gifts}}"
          wx:key="id"
          item="{{item}}"
          collection-type="{{activeCollection}}"
          emphasized="{{recentGiftId === item.id}}"
          removing="{{removingGiftId === item.id}}"
          bindpreview="previewImage"
          bindedit="openEditForm"
          bindimageerror="handleImageError"
        ></collection-item-card>
      </view>

      <view wx:if="{{!isInitialLoading && gifts.length && hasMore}}" class="load-more" bindtap="loadMoreGifts">
        <text>{{isLoadingMore ? '正在加载…' : '继续加载更多'}}</text>
      </view>

      <view wx:if="{{!isInitialLoading && !gifts.length}}" class="empty-state">
        <view wx:if="{{activeCollection === 'gift'}}" class="empty-gift-icon" aria-hidden="true">
          <view class="empty-gift-lid"></view>
          <view class="empty-gift-box"></view>
          <view class="empty-gift-ribbon"></view>
        </view>
        <view wx:else class="empty-house-icon" aria-hidden="true">
          <view class="empty-house-roof"></view>
          <view class="empty-house-body"></view>
          <view class="empty-house-door"></view>
        </view>
        <text class="empty-title">{{collectionEmptyTitle}}</text>
        <button class="empty-add-button" bindtap="openCreateForm">{{collectionEmptyButton}}</button>
      </view>
    </view>
  </scroll-view>

  <button
    wx:if="{{!accessDenied && !isInitialLoading && gifts.length}}"
    class="floating-add-button"
    bindtap="openCreateForm"
    aria-label="{{collectionAddAria}}"
  >
    <!-- 使用几何线条绘制加号，避免系统字体基线造成视觉偏移 -->
    <view class="floating-add-icon" aria-hidden="true">
      <view class="floating-add-stroke floating-add-stroke-horizontal"></view>
      <view class="floating-add-stroke floating-add-stroke-vertical"></view>
    </view>
  </button>

  <view wx:if="{{formVisible}}" class="form-mask {{formClosing ? 'motion-mask-closing' : ''}}" bindtap="requestCloseForm" catchtouchmove="stopTap">
    <view class="form-panel" style="{{formSheetStyle}}" catchtap="stopTap" catchtouchmove="stopTap">
      <view
        class="form-drag-zone"
        bindtouchstart="handleFormDragStart"
        bindtouchmove="handleFormDragMove"
        bindtouchend="handleFormDragEnd"
        bindtouchcancel="handleFormDragEnd"
      >
        <view class="sheet-drag-area">
          <view class="sheet-drag-handle"></view>
        </view>
        <view class="form-header">
          <text class="form-title">{{formTitle}}</text>
        </view>
      </view>

      <scroll-view class="form-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="form-content">
          <view class="image-picker" bindtap="showImageSourceActions">
            <image
              wx:if="{{form.imagePath}}"
              class="image-picker-preview"
              src="{{form.imagePath}}"
              mode="aspectFill"
            ></image>
            <view wx:else class="image-picker-empty">
              <view class="image-picker-plus" aria-hidden="true">
                <view class="image-picker-plus-stroke image-picker-plus-stroke-horizontal"></view>
                <view class="image-picker-plus-stroke image-picker-plus-stroke-vertical"></view>
              </view>
              <text class="image-picker-label">{{collectionImageLabel}}</text>
            </view>
            <view
              wx:if="{{form.imagePath}}"
              class="image-picker-remove"
              catchtap="confirmRemoveFormImage"
              aria-role="button"
              aria-label="移除当前图片"
            >×</view>
          </view>

          <view class="form-field">
            <view class="field-label-row">
              <text class="field-label">{{collectionNameLabel}}</text>
              <text class="field-optional">选填</text>
            </view>
            <input
              class="form-input"
              value="{{form.name}}"
              disabled="{{isSaving || isDeleting || isMoving}}"
              placeholder="{{collectionNamePlaceholder}}"
              placeholder-class="form-placeholder"
              maxlength="40"
              confirm-type="next"
              bindinput="handleNameInput"
            />
          </view>

          <view class="form-field">
            <view class="field-label-row">
              <text class="field-label">简介</text>
              <text class="field-optional">选填</text>
            </view>
            <textarea
              class="form-textarea"
              value="{{form.description}}"
              disabled="{{isSaving || isDeleting || isMoving}}"
              placeholder="记录款式、颜色或喜欢它的原因"
              placeholder-class="form-placeholder"
              maxlength="200"
              auto-height
              bindinput="handleDescriptionInput"
            ></textarea>
          </view>
        </view>
      </scroll-view>

      <button
        wx:if="{{isEditing}}"
        class="move-button"
        disabled="{{isSaving || isDeleting || isMoving}}"
        bindtap="confirmMove"
      >{{isMoving ? '正在移动…' : '移到' + moveTargetTitle}}</button>

      <view class="form-footer">
        <button
          wx:if="{{isEditing}}"
          class="delete-button"
          disabled="{{isSaving || isDeleting || isMoving}}"
          bindtap="confirmDelete"
        >
          删除
        </button>
        <button
          class="save-button {{saveDisabled ? 'save-button-disabled' : ''}}"
          disabled="{{saveDisabled}}"
          bindtap="saveGift"
        >
          {{collectionSaveText}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{isPreviewVisible}}" class="image-preview-mask {{previewClosing ? 'image-preview-mask-closing' : ''}}" catchtouchmove="stopTap">
    <view class="image-preview-panel {{previewClosing ? 'image-preview-panel-closing' : ''}}" catchtap="stopTap">
      <image class="image-preview-full" src="{{previewImagePath}}" mode="aspectFit" bindtap="closePreview"></image>
      <button class="image-preview-exit" bindtap="closePreview">点击图片或此处退出</button>
    </view>
  </view>
</view>
