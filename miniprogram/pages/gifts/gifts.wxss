.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  background: #f7f7f5;
  background-repeat: no-repeat;
  background-size: cover;
}

.gift-header {
  position: relative;
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  overflow: hidden;
  min-height: 188rpx;
  padding: 36rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 28rpx;
  color: #ffffff;
  background: rgba(32, 32, 30, 0.32);
  box-shadow: 0 18rpx 42rpx rgba(68, 60, 56, 0.16);
}

.gift-header-bg,
.gift-header-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.gift-header-bg {
  width: 100%;
  height: 100%;
}

.gift-header-overlay {
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.28) 0%, rgba(0, 0, 0, 0.08) 100%);
}

.gift-header-copy {
  position: relative;
  z-index: 1;
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 12rpx;
}

.gift-header-title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #ffffff;
}

.gift-header-subtitle {
  font-size: 24rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.88);
}

.gift-list {
  margin-top: 24rpx;
}

.gift-skeleton-list {
  margin-top: 24rpx;
}

.gift-skeleton-card {
  pointer-events: none;
}

.gift-skeleton-image {
  flex: 0 0 auto;
  width: 164rpx;
  min-height: 152rpx;
  border-radius: 18rpx;
}

.gift-skeleton-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  padding: 8rpx 0;
}

.gift-skeleton-title {
  width: 48%;
  height: 32rpx;
  border-radius: 10rpx;
}

.gift-skeleton-line {
  height: 22rpx;
  border-radius: 8rpx;
}

.gift-skeleton-line-long {
  width: 86%;
  margin-top: 24rpx;
}

.gift-skeleton-line-short {
  width: 58%;
  margin-top: 14rpx;
}

.gift-skeleton-block {
  background: linear-gradient(
    100deg,
    rgba(238, 226, 222, 0.72) 20%,
    rgba(249, 243, 241, 0.96) 42%,
    rgba(238, 226, 222, 0.72) 64%
  );
  background-size: 220% 100%;
  animation: gift-skeleton-shimmer 1.5s ease-in-out infinite;
}

.load-more {
  margin: 24rpx 0 8rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a58f89;
}

.access-denied-state {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 560rpx;
  margin-top: 24rpx;
  padding: 56rpx 42rpx;
  border: 1rpx solid #eadbd8;
  border-radius: 24rpx;
  flex-direction: column;
  text-align: center;
  background: rgba(255, 255, 255, 0.86);
}

.access-denied-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1;
  color: #ffffff;
  background: #d97986;
}

.access-denied-title {
  margin-top: 26rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
  color: #2d2926;
}

.access-denied-description {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #847a73;
}

.access-denied-button {
  min-width: 196rpx;
  min-height: 64rpx;
  margin-top: 30rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 64rpx;
  color: #ffffff;
  background: #d97986;
}

.gift-card {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  box-sizing: border-box;
  overflow: hidden;
  width: 100%;
  min-height: 184rpx;
  margin-bottom: 18rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(234, 225, 221, 0.72);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 28rpx rgba(109, 84, 78, 0.08);
  animation: content-rise-in 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
  transform-origin: center top;
  transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 180ms ease-out;
}

.gift-card:active {
  transform: scale(0.992);
  box-shadow: 0 8rpx 20rpx rgba(109, 84, 78, 0.08);
}

.gift-card-emphasis {
  animation: gift-card-emphasis 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.gift-card-removing {
  pointer-events: none;
  animation: gift-card-remove 240ms ease-in both;
}

.gift-image-wrap {
  position: relative;
  flex: 0 0 auto;
  overflow: hidden;
  width: 164rpx;
  min-height: 152rpx;
  border-radius: 18rpx;
  background: #f3e9e5;
}

.gift-image {
  width: 100%;
  height: 100%;
  min-height: 152rpx;
}

.gift-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-gift {
  position: relative;
  width: 72rpx;
  height: 70rpx;
}

.placeholder-lid,
.placeholder-box,
.placeholder-ribbon {
  position: absolute;
  box-sizing: border-box;
}

.placeholder-lid {
  top: 12rpx;
  left: 2rpx;
  width: 68rpx;
  height: 20rpx;
  border: 5rpx solid #d99ba4;
  border-radius: 8rpx;
}

.placeholder-box {
  top: 32rpx;
  left: 8rpx;
  width: 56rpx;
  height: 36rpx;
  border: 5rpx solid #d99ba4;
  border-top: 0;
  border-radius: 0 0 9rpx 9rpx;
}

.placeholder-ribbon {
  top: 8rpx;
  left: 31rpx;
  width: 10rpx;
  height: 60rpx;
  border-radius: 4rpx;
  background: #d99ba4;
}

.gift-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  padding: 2rpx 0;
}

.gift-title-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  min-width: 0;
}

.gift-name {
  display: -webkit-box;
  flex: 1;
  overflow: hidden;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: break-word;
  word-break: break-all;
  color: #2d2926;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.gift-date {
  flex: 0 0 auto;
  font-size: 19rpx;
  line-height: 1.45;
  color: #b09f99;
}

.gift-description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 9rpx;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  overflow-wrap: break-word;
  word-break: break-all;
  color: #847a73;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.gift-edit-hint {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  margin-top: auto;
  padding-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #a58f89;
}

.gift-edit-arrow {
  font-size: 30rpx;
  line-height: 20rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 560rpx;
  margin-top: 24rpx;
  padding: 50rpx 30rpx;
  border: 1rpx dashed #eadbd8;
  border-radius: 24rpx;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.72);
}

.empty-gift-icon {
  position: relative;
  width: 112rpx;
  height: 106rpx;
  margin-bottom: 24rpx;
}

.empty-gift-lid,
.empty-gift-box,
.empty-gift-ribbon {
  position: absolute;
  box-sizing: border-box;
}

.empty-gift-lid {
  top: 18rpx;
  left: 4rpx;
  width: 104rpx;
  height: 28rpx;
  border: 7rpx solid #d97986;
  border-radius: 10rpx;
}

.empty-gift-box {
  top: 46rpx;
  left: 12rpx;
  width: 88rpx;
  height: 58rpx;
  border: 7rpx solid #d97986;
  border-top: 0;
  border-radius: 0 0 12rpx 12rpx;
}

.empty-gift-ribbon {
  top: 12rpx;
  left: 49rpx;
  width: 14rpx;
  height: 92rpx;
  border-radius: 5rpx;
  background: #d97986;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #2d2926;
}

.empty-add-button {
  box-sizing: border-box;
  min-width: 196rpx;
  min-height: 58rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 58rpx;
  color: #ffffff;
  background: #d97986;
  box-shadow: 0 8rpx 18rpx rgba(217, 121, 134, 0.2);
  transition: transform 150ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 150ms ease-out, background-color 150ms ease-out;
}

.floating-add-button {
  position: fixed;
  right: 30rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 88rpx;
  height: 88rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  max-width: 88rpx;
  max-height: 88rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 5rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  color: #ffffff;
  background: #d97986;
  box-shadow: 0 14rpx 30rpx rgba(112, 73, 80, 0.24);
  transition: transform 150ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 150ms ease-out, background-color 150ms ease-out;
}

.floating-add-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}

.floating-add-stroke {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.floating-add-stroke-horizontal {
  width: 34rpx;
  height: 4rpx;
}

.floating-add-stroke-vertical {
  width: 4rpx;
  height: 34rpx;
}

.empty-add-button:active,
.floating-add-button:active,
.save-button:active,
.delete-button:active {
  transform: scale(0.95);
}

.form-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(20, 20, 20, 0.42);
  animation: mask-fade-in 180ms ease-out;
}

.motion-mask-closing {
  pointer-events: none;
  animation: mask-fade-out 220ms ease-in both;
}

.form-panel {
  display: flex;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  height: 82vh;
  max-height: 82vh;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 36rpx 36rpx 0 0;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -18rpx 48rpx rgba(80, 54, 58, 0.18);
  animation: sheet-slide-up 260ms cubic-bezier(0.22, 1, 0.36, 1);
  transition: transform 240ms ease-out;
}

.form-drag-zone {
  flex: 0 0 auto;
}

.sheet-drag-area {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  height: 42rpx;
}

.sheet-drag-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e6d9d7;
}

.form-header {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 6rpx 28rpx 22rpx;
  border-bottom: 1rpx solid #f5ece9;
}

.form-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #2d2926;
}

.form-scroll {
  flex: 1;
  min-height: 0;
}

.form-content {
  box-sizing: border-box;
  padding: 24rpx 28rpx 36rpx;
}

.image-picker {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  height: 300rpx;
  border: 1rpx dashed #dfc8c5;
  border-radius: 22rpx;
  background: #f9f7f5;
}

.image-picker-preview {
  width: 100%;
  height: 100%;
}

.image-picker-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  flex-direction: column;
}

.image-picker-plus {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #d97986;
}

.image-picker-plus-stroke {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.image-picker-plus-stroke-horizontal {
  width: 28rpx;
  height: 4rpx;
}

.image-picker-plus-stroke-vertical {
  width: 4rpx;
  height: 28rpx;
}

.image-picker-label {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.3;
  color: #847a73;
}

.image-picker-remove {
  position: absolute;
  z-index: 2;
  top: 16rpx;
  left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-sizing: border-box;
  width: 54rpx;
  min-width: 54rpx;
  max-width: 54rpx;
  height: 54rpx;
  min-height: 54rpx;
  max-height: 54rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
  color: #ffffff;
  background: rgba(42, 35, 33, 0.56);
  box-shadow: 0 4rpx 14rpx rgba(42, 35, 33, 0.2);
}

.image-preview-mask {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.94);
  animation: preview-mask-in 220ms ease-out both;
}

.image-preview-panel {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  animation: preview-scale-in 280ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.image-preview-mask-closing {
  pointer-events: none;
  animation: mask-fade-out 220ms ease-in both;
}

.image-preview-panel-closing {
  animation: preview-scale-out 200ms ease-in both;
}

.image-preview-full {
  width: 100%;
  height: calc(100% - 160rpx);
}

.image-preview-exit {
  box-sizing: border-box;
  min-width: 260rpx;
  min-height: 64rpx;
  margin: 18rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  padding: 0 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
  transition: transform 150ms cubic-bezier(0.22, 1, 0.36, 1), background-color 150ms ease-out;
}

.image-preview-exit:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.24);
}

.form-field {
  margin-top: 26rpx;
}

.field-label-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.field-label {
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #2d2926;
}

.field-optional {
  padding: 4rpx 8rpx;
  border-radius: 7rpx;
  font-size: 18rpx;
  line-height: 1.2;
  color: #9a7a73;
  background: #f4f3f1;
}

.form-input,
.form-textarea {
  display: block;
  box-sizing: border-box;
  width: 100%;
  margin-top: 12rpx;
  border: 1rpx solid #eadbd8;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #2d2926;
  background: #ffffff;
}

.form-input {
  height: 72rpx;
  padding: 0 20rpx;
  line-height: 72rpx;
}

.form-textarea {
  min-height: 136rpx;
  padding: 18rpx 20rpx;
}

.form-placeholder {
  color: #b7a9a3;
}

.form-footer {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  padding: 18rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.save-button,
.delete-button {
  box-sizing: border-box;
  height: 80rpx;
  min-height: 80rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 80rpx;
  transition: transform 150ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 150ms ease-out, background-color 150ms ease-out;
}

.save-button {
  flex: 1;
  color: #ffffff;
  background: #d97986;
  box-shadow: 0 12rpx 24rpx rgba(217, 121, 134, 0.24);
}

.delete-button {
  flex: 0 0 126rpx;
  border: 1rpx solid #eadbd8;
  color: #c45f72;
  background: #ffffff;
}

.save-button-disabled {
  color: rgba(255, 255, 255, 0.78);
  background: #d8cbc8;
  box-shadow: none;
}

@keyframes mask-fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes sheet-slide-up {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

@keyframes mask-fade-out {
  from {
    opacity: 1;
  }

  to {
    opacity: 0;
  }
}

@keyframes content-rise-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes gift-card-emphasis {
  0% {
    opacity: 0.82;
    transform: translateY(10rpx) scale(0.985);
  }

  68% {
    opacity: 1;
    transform: translateY(0) scale(1.012);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes gift-card-remove {
  from {
    opacity: 1;
    max-height: 600rpx;
    margin-bottom: 18rpx;
    padding-top: 16rpx;
    padding-bottom: 16rpx;
    transform: scale(1);
  }

  to {
    opacity: 0;
    max-height: 0;
    min-height: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-width: 0;
    transform: scale(0.98);
  }
}

@keyframes preview-mask-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes preview-scale-in {
  from {
    opacity: 0;
    transform: scale(0.96);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes preview-scale-out {
  from {
    opacity: 1;
    transform: scale(1);
  }

  to {
    opacity: 0;
    transform: scale(0.98);
  }
}

@keyframes gift-skeleton-shimmer {
  from {
    background-position: 100% 0;
  }

  to {
    background-position: -100% 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .gift-skeleton-block,
  .gift-card,
  .gift-card-emphasis,
  .gift-card-removing,
  .form-mask,
  .form-panel,
  .image-preview-mask,
  .image-preview-panel {
    animation: none;
  }

  .gift-card,
  .empty-add-button,
  .floating-add-button,
  .form-panel,
  .save-button,
  .delete-button,
  .image-preview-exit {
    transition: none;
  }
}

@media (max-width: 360px) {
  .page {
    padding-right: 18rpx;
    padding-left: 18rpx;
  }

  .gift-header,
  .gift-card {
    border-radius: 14rpx;
  }

  .gift-image-wrap {
    width: 138rpx;
  }

  .gift-skeleton-image {
    width: 138rpx;
  }

  .gift-date {
    display: none;
  }

  .form-content {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .form-footer {
    gap: 10rpx;
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .delete-button {
    flex-basis: 110rpx;
    font-size: 24rpx;
  }
}
