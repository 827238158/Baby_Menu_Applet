<view class="page">
  <view class="shop-header">
    <view class="shop-copy">
      <text class="shop-name">{{shop.name}}</text>
      <text class="shop-subtitle">{{shop.subtitle}}</text>
    </view>
    <button class="share-button" open-type="share">分享菜单</button>
  </view>

  <view class="content">
    <scroll-view class="category-list" scroll-y enhanced show-scrollbar="{{false}}">
      <block wx:for="{{categories}}" wx:key="id">
        <view
          class="category-item {{activeCategoryId === item.id ? 'category-item-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="switchCategory"
        >
          {{item.name}}
        </view>
      </block>
    </scroll-view>

    <scroll-view class="dish-list" scroll-y enhanced show-scrollbar="{{false}}">
      <block wx:for="{{activeItems}}" wx:key="id">
        <view class="dish-card">
          <image class="dish-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="dish-info">
            <view class="dish-title-row">
              <text class="dish-name">{{item.name}}</text>
              <text wx:if="{{item.price}}" class="dish-price">¥{{item.price}}</text>
            </view>
            <text class="dish-desc">{{item.desc}}</text>
            <view class="tag-row" wx:if="{{item.tags && item.tags.length}}">
              <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>
            <view class="dish-actions">
              <button class="ghost-button" data-id="{{item.id}}" bindtap="showDetail">详情</button>
              <button class="add-button" data-id="{{item.id}}" bindtap="addDish">加入</button>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>

  <view class="selected-bar">
    <view class="selected-summary">
      <text class="selected-count">已选 {{selectedCount}} 份</text>
      <text class="selected-total">模拟合计 ¥{{selectedTotal}}</text>
    </view>
    <button wx:if="{{selectedCount > 0}}" class="clear-button" bindtap="clearSelected">清空</button>
    <button class="disabled-order-button">仅展示，不可下单</button>
  </view>

  <view wx:if="{{detailVisible}}" class="modal-mask" bindtap="hideDetail">
    <view class="detail-panel" catchtap="stopTap">
      <image class="detail-image" src="{{currentItem.image}}" mode="aspectFill"></image>
      <view class="detail-body">
        <view class="detail-title-row">
          <text class="detail-title">{{currentItem.name}}</text>
          <text wx:if="{{currentItem.price}}" class="detail-price">¥{{currentItem.price}}</text>
        </view>
        <text class="detail-desc">{{currentItem.desc}}</text>
        <view class="tag-row detail-tags" wx:if="{{currentItem.tags && currentItem.tags.length}}">
          <text class="tag" wx:for="{{currentItem.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <view class="detail-actions">
          <button class="close-button" bindtap="hideDetail">关闭</button>
          <button class="add-button detail-add" data-id="{{currentItem.id}}" bindtap="addDish">加入展示菜单</button>
        </view>
      </view>
    </view>
  </view>
</view>
