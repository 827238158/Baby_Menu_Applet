<view class="page" style="{{pageStyle}}">
  <view class="shop-header">
    <image
      wx:if="{{shop.headerBackgroundImage}}"
      class="shop-header-bg"
      src="{{shop.headerBackgroundImage}}"
      mode="aspectFill"
    ></image>
    <view class="shop-header-overlay"></view>
    <view class="shop-copy">
      <text class="shop-name">{{shop.name}}</text>
      <text class="shop-subtitle">{{shop.subtitle}}</text>
    </view>
  </view>

  <view class="content">
    <scroll-view class="category-list" scroll-y enhanced show-scrollbar="{{false}}">
      <block wx:for="{{categories}}" wx:key="id">
        <view
          class="category-item {{activeCategoryId === item.id ? 'category-item-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="switchCategory"
        >
          <text class="category-name">{{item.name}}</text>
          <text wx:if="{{item.count === 0}}" class="category-empty-label">待添加</text>
        </view>
      </block>
    </scroll-view>

    <scroll-view class="dish-list" scroll-y enhanced show-scrollbar="{{false}}">
      <block wx:if="{{activeItems.length > 0}}">
        <block wx:for="{{activeItems}}" wx:key="id">
          <view class="dish-card">
            <view class="dish-card-main">
              <image
                class="dish-image"
                src="{{item.image}}"
                mode="aspectFill"
                data-id="{{item.id}}"
                binderror="handleImageError"
              ></image>
              <view class="dish-info">
                <view class="dish-title-row">
                  <text class="dish-name">{{item.name}}</text>
                  <text wx:if="{{item.price}}" class="dish-price">¥{{item.price}}</text>
                </view>
                <view class="tag-row" wx:if="{{item.tags && item.tags.length}}">
                  <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                </view>
                <text class="dish-desc">{{item.desc}}</text>
                <view class="dish-cart-action">
                  <view wx:if="{{item.options && item.options.length}}" class="quick-action-wrap">
                    <view class="quick-add-button" data-id="{{item.id}}" bindtap="addDish">+</view>
                    <text wx:if="{{item.cartQuantity > 0}}" class="dish-cart-count">{{item.cartQuantity}}</text>
                  </view>
                  <view wx:else class="quick-action-wrap">
                    <view wx:if="{{item.cartQuantity > 0}}" class="card-stepper">
                      <button class="stepper-button" data-key="{{item.directSelectionKey}}" bindtap="decreaseCartItem">-</button>
                      <text class="stepper-count">{{item.cartQuantity}}</text>
                      <button class="stepper-button stepper-plus" data-id="{{item.id}}" bindtap="addDish">+</button>
                    </view>
                    <view wx:else class="quick-add-button" data-id="{{item.id}}" bindtap="addDish">+</view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>
      </block>
      <view wx:else class="empty-state">
        <text>待添加</text>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{cartVisible}}" class="cart-mask" bindtap="hideCartPanel">
    <view class="cart-panel" catchtap="stopTap">
      <view class="cart-header">
        <text class="cart-title">购物车</text>
      </view>
      <scroll-view class="cart-list" scroll-y enhanced show-scrollbar="{{false}}">
        <block wx:for="{{selectedItems}}" wx:key="selectionKey">
          <view class="cart-item">
            <image
              class="cart-item-image"
              src="{{item.image}}"
              mode="aspectFill"
              data-id="{{item.id}}"
              binderror="handleImageError"
            ></image>
            <view class="cart-item-info">
              <view class="cart-item-title-row">
                <text class="cart-item-name">{{item.name}}</text>
                <text wx:if="{{item.optionText}}" class="cart-item-options">{{item.optionText}}</text>
              </view>
              <text class="cart-item-price">小计 ¥{{item.itemTotal}}</text>
            </view>
            <view class="cart-item-controls">
              <view class="cart-stepper">
                <button class="stepper-button" data-key="{{item.selectionKey}}" bindtap="decreaseCartItem">-</button>
                <text class="stepper-count">{{item.quantity}}</text>
                <button class="stepper-button stepper-plus" data-key="{{item.selectionKey}}" bindtap="increaseCartItem">+</button>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
      <view class="cart-remark">
        <text class="cart-remark-label">备注</text>
        <input
          class="cart-remark-input"
          value="{{cartRemark}}"
          placeholder="加备注，如多加香菜"
          placeholder-class="cart-remark-placeholder"
          maxlength="80"
          confirm-type="done"
          bindinput="handleCartRemarkInput"
        />
      </view>
    </view>
  </view>

  <view class="cart-bar">
    <view class="cart-entry" bindtap="toggleCartPanel">
      <view class="cart-icon-wrap">
        <view class="cart-icon" aria-hidden="true">
          <view class="cart-icon-handle"></view>
          <view class="cart-icon-bag"></view>
        </view>
        <text wx:if="{{selectedCount > 0}}" class="cart-badge">{{selectedCount}}</text>
      </view>
      <view class="cart-summary">
        <text class="cart-total">¥{{selectedTotal}}</text>
        <text class="cart-hint">{{selectedSummaryText}}</text>
      </view>
    </view>
    <view class="cart-actions">
      <button class="copy-button" bindtap="copySelectedMenu">复制分享</button>
    </view>
  </view>

  <view wx:if="{{detailVisible}}" class="modal-mask" bindtap="hideDetail" catchtouchmove="stopTouchMove">
    <view
      class="detail-panel"
      style="{{detailSheetStyle}}"
      catchtap="stopTap"
      catchtouchmove="stopTouchMove"
    >
      <view
        class="detail-drag-zone"
        bindtouchstart="handleDetailDragStart"
        bindtouchmove="handleDetailDragMove"
        bindtouchend="handleDetailDragEnd"
        bindtouchcancel="handleDetailDragEnd"
      >
        <view class="sheet-drag-area">
          <view class="sheet-drag-handle"></view>
        </view>
        <view class="sheet-header">
          <image
            class="sheet-thumb"
            src="{{currentItem.image}}"
            mode="aspectFill"
            data-id="{{currentItem.id}}"
            binderror="handleImageError"
          ></image>
          <view class="detail-body">
            <view class="detail-title-row">
              <text class="detail-title">{{currentItem.name}}</text>
              <text wx:if="{{currentItem.price}}" class="detail-price">¥{{currentItem.price}}</text>
            </view>
            <text class="sheet-desc">{{currentItem.desc}}</text>
          </view>
        </view>
        <view class="selected-spec-card">
          <text class="selected-spec-label">已选规格</text>
          <text class="selected-spec-text {{optionReady ? 'selected-spec-ready' : ''}}">{{optionSummaryText}}</text>
        </view>
      </view>
      <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="option-section" wx:if="{{currentItem.options && currentItem.options.length}}">
          <block wx:for="{{currentItem.options}}" wx:for-item="option" wx:key="id">
            <view class="option-group">
              <view class="option-title-row">
                <text class="option-title">{{option.name}}</text>
                <text wx:if="{{option.required}}" class="option-required">必选</text>
              </view>
              <view wx:if="{{option.type === 'text'}}" class="option-input-wrap">
                <input
                  class="option-input"
                  value="{{option.value}}"
                  placeholder="{{option.placeholder}}"
                  placeholder-class="option-input-placeholder"
                  maxlength="{{option.maxlength}}"
                  confirm-type="done"
                  data-option-id="{{option.id}}"
                  bindinput="handleTextOptionInput"
                />
              </view>
              <view wx:else class="option-choice-row">
                <view
                  wx:for="{{option.choices}}"
                  wx:for-item="choice"
                  wx:key="id"
                  class="option-choice {{choice.selected ? 'option-choice-active' : ''}}"
                  data-option-id="{{option.id}}"
                  data-choice-id="{{choice.id}}"
                  bindtap="selectOption"
                >
                  {{choice.name}}
                </view>
              </view>
            </view>
          </block>
          <text wx:if="{{optionNotice}}" class="option-notice">{{optionNotice}}</text>
        </view>
      </scroll-view>
      <view class="detail-actions">
        <button
          class="add-button detail-add {{optionReady ? '' : 'detail-add-disabled'}}"
          disabled="{{!optionReady}}"
          bindtap="confirmAddDish"
        >
          加入购物车
        </button>
      </view>
    </view>
  </view>
</view>
