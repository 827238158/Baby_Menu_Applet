.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 164rpx;
  background: #f7f7f5;
  background-repeat: no-repeat;
  background-size: cover;
}

button {
  margin: 0;
}

button::after {
  border: 0;
}

.shop-header {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
  min-height: 188rpx;
  padding: 36rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, rgba(32, 32, 30, 0.48) 0%, rgba(32, 32, 30, 0.12) 100%);
  box-shadow: 0 18rpx 42rpx rgba(68, 60, 56, 0.16);
}

.shop-header-bg,
.shop-header-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.shop-header-bg {
  width: 100%;
  height: 100%;
}

.shop-header-overlay {
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.06) 100%);
}

.shop-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 12rpx;
}

.shop-kicker {
  align-self: flex-start;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.52);
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
  color: rgba(255, 255, 255, 0.9);
}

.shop-name {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #ffffff;
}

.shop-subtitle {
  font-size: 24rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.88);
}

.shop-stats {
  font-size: 23rpx;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.88);
}

.content {
  display: flex;
  gap: 14rpx;
  height: calc(100vh - 380rpx);
  min-height: 680rpx;
  margin-top: 24rpx;
}

.category-list {
  flex: 0 0 146rpx;
  width: 146rpx;
  height: 100%;
}

.category-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 14rpx;
  border: 1rpx solid rgba(226, 218, 214, 0.7);
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.25;
  text-align: center;
  color: #847a73;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 18rpx rgba(112, 89, 83, 0.05);
  transition: background-color 160ms ease, color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
}

.category-item-active {
  color: #d97986;
  border-color: rgba(217, 121, 134, 0.28);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 22rpx rgba(80, 72, 68, 0.08);
}

.category-item:active {
  transform: scale(0.98);
}

.category-name {
  display: -webkit-box;
  overflow: hidden;
  max-width: 100%;
  line-height: 1.22;
  text-overflow: ellipsis;
  white-space: normal;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.category-empty-label {
  display: block;
  max-width: 100%;
  padding: 3rpx 8rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #a58f89;
  background: #f4f3f1;
}

.category-count {
  display: block;
  overflow: hidden;
  max-width: 100%;
  font-size: 20rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: inherit;
  opacity: 0.74;
}

.dish-list {
  flex: 1;
  min-width: 0;
  height: 100%;
}

.dish-card {
  box-sizing: border-box;
  overflow: hidden;
  width: 100%;
  margin-bottom: 18rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(234, 225, 221, 0.72);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 28rpx rgba(109, 84, 78, 0.08);
  transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
}

.dish-card:active {
  transform: scale(0.992);
  box-shadow: 0 8rpx 20rpx rgba(109, 84, 78, 0.08);
}

.dish-card-main {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 14rpx;
  min-width: 0;
}

.dish-image {
  align-self: center;
  flex: 0 0 auto;
  width: 134rpx;
  height: 134rpx;
  border-radius: 18rpx;
  background: #f3e9e5;
}

.dish-info {
  display: flex;
  flex: 1;
  width: 0;
  min-width: 0;
  max-width: 100%;
  min-height: 134rpx;
  flex-direction: column;
}

.dish-title-row,
.detail-title-row {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 6rpx 10rpx;
  flex-wrap: wrap;
}

.dish-name {
  display: block;
  flex: 1;
  overflow: hidden;
  min-width: 0;
  max-width: 100%;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  overflow-wrap: break-word;
  word-break: break-all;
  color: #2d2926;
}

.dish-price,
.detail-price {
  flex: 0 0 auto;
  max-width: 100%;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.25;
  overflow-wrap: break-word;
  word-break: break-all;
  color: #d97986;
}

.dish-desc {
  display: -webkit-box;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  margin-top: 7rpx;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  overflow-wrap: break-word;
  word-break: break-all;
  color: #847a73;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  overflow: hidden;
  max-width: 100%;
  margin-top: 9rpx;
}

.tag {
  display: block;
  box-sizing: border-box;
  overflow: hidden;
  max-width: 100%;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #6f625d;
  background: #f3f2ef;
}

.option-hint {
  align-self: flex-start;
  box-sizing: border-box;
  max-width: 100%;
  margin-top: 12rpx;
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #9a7a63;
  background: #fff5ed;
}

.dish-option-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  overflow: hidden;
  max-height: 42rpx;
  margin-top: 9rpx;
}

.dish-option-chip {
  box-sizing: border-box;
  max-width: 112rpx;
  padding: 5rpx 9rpx;
  border: 1rpx solid #efe1dc;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9a7a73;
  background: rgba(255, 255, 255, 0.92);
}

.dish-cart-action {
  display: flex;
  width: 100%;
  align-items: flex-end;
  justify-content: flex-end;
  margin-top: auto;
  padding-top: 10rpx;
}

.dish-cart-count {
  position: absolute;
  top: -12rpx;
  right: -10rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
  color: #ffffff;
  background: #d97986;
}

.quick-action-wrap {
  position: relative;
  display: flex;
  justify-content: flex-end;
  width: auto;
  max-width: 100%;
}

.quick-add-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-weight: 700;
  text-align: center;
  color: #ffffff;
  background: #d97986;
  width: 46rpx;
  height: 46rpx;
  min-width: 46rpx;
  min-height: 46rpx;
  padding: 0;
  font-size: 30rpx;
  line-height: 46rpx;
  box-shadow: 0 8rpx 18rpx rgba(217, 121, 134, 0.24);
  transition: transform 160ms ease, background-color 160ms ease, opacity 160ms ease, box-shadow 160ms ease;
}

.quick-add-button:active {
  transform: scale(0.94);
  background: #c96f7c;
  box-shadow: 0 4rpx 12rpx rgba(217, 121, 134, 0.2);
}

.card-stepper,
.cart-stepper {
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.card-stepper {
  box-sizing: border-box;
  min-width: 118rpx;
  height: 46rpx;
  gap: 5rpx;
  justify-content: flex-end;
  transition: opacity 160ms ease, transform 160ms ease;
}

.stepper-button {
  box-sizing: border-box;
  width: 42rpx;
  height: 42rpx;
  min-height: 42rpx;
  padding: 0;
  border: 1rpx solid #efd9dd;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
  color: #d97986;
  background: #ffffff;
  transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
}

.stepper-button:active,
.option-choice:active,
.copy-button:active,
.detail-add:active {
  transform: scale(0.96);
}

.stepper-plus {
  border-color: #d97986;
  color: #ffffff;
  background: #d97986;
  box-shadow: 0 6rpx 14rpx rgba(217, 121, 134, 0.18);
}

.stepper-count {
  min-width: 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  color: #2d2926;
}

.card-stepper .stepper-button {
  width: 46rpx;
  height: 46rpx;
  min-height: 46rpx;
  line-height: 42rpx;
}

.card-stepper .stepper-count {
  min-width: 22rpx;
}

.add-button,
.copy-button {
  box-sizing: border-box;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 58rpx;
}

.cart-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 35;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  padding: 32rpx 24rpx 156rpx;
  background: rgba(20, 20, 20, 0.34);
  animation: mask-fade-in 180ms ease-out;
}

.cart-panel {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  max-height: 58vh;
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 48rpx rgba(80, 54, 58, 0.18);
  animation: sheet-slide-up 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.cart-header {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 76rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f4ece8;
}

.cart-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2d2926;
}

.cart-list {
  flex: 1;
  min-height: 0;
  max-height: calc(58vh - 172rpx);
}

.cart-remark {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  padding: 18rpx 20rpx 20rpx;
  border-top: 1rpx solid #f4ece8;
  background: rgba(255, 255, 255, 0.98);
}

.cart-remark-label {
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #2d2926;
}

.cart-remark-input {
  display: block;
  flex: 1;
  box-sizing: border-box;
  min-width: 0;
  height: 58rpx;
  padding: 0 18rpx;
  border: 1rpx solid #efe1dc;
  border-radius: 999rpx;
  font-size: 23rpx;
  line-height: 58rpx;
  color: #2d2926;
  background: #f9f7f5;
}

.cart-remark-placeholder {
  color: #b7a9a3;
}

.cart-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  border-bottom: 1rpx solid #f0eee9;
}

.cart-item-image {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #f3e9e5;
}

.cart-item-info {
  display: flex;
  flex: 1;
  overflow: hidden;
  width: 0;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.cart-item-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx 8rpx;
  min-width: 0;
}

.cart-item-name {
  display: block;
  overflow: hidden;
  max-width: 100%;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #2d2926;
}

.cart-item-options {
  display: block;
  box-sizing: border-box;
  overflow: hidden;
  max-width: 100%;
  padding: 4rpx 9rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: normal;
  overflow-wrap: break-word;
  word-break: break-all;
  color: #6f625d;
  background: #f4f3f1;
}

.cart-item-price {
  overflow: hidden;
  font-size: 20rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9a7a73;
}

.cart-item-controls {
  display: flex;
  flex: 0 0 112rpx;
  align-items: flex-end;
}

.cart-stepper .stepper-button {
  width: 40rpx;
  height: 40rpx;
  min-height: 40rpx;
  line-height: 36rpx;
}

.cart-bar {
  position: fixed;
  right: 24rpx;
  bottom: 28rpx;
  left: 24rpx;
  z-index: 45;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
  height: 112rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(233, 218, 216, 0.78);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(85, 61, 65, 0.14);
}

.cart-entry {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.cart-icon-wrap {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #d97986;
  box-shadow: 0 8rpx 18rpx rgba(217, 121, 134, 0.22);
}

.cart-icon {
  position: relative;
  width: 42rpx;
  height: 44rpx;
}

.cart-icon-handle {
  position: absolute;
  top: 2rpx;
  left: 11rpx;
  box-sizing: border-box;
  width: 20rpx;
  height: 18rpx;
  border: 4rpx solid #ffffff;
  border-bottom: 0;
  border-radius: 999rpx 999rpx 0 0;
  background: transparent;
}

.cart-icon-bag {
  position: absolute;
  right: 4rpx;
  bottom: 2rpx;
  left: 4rpx;
  box-sizing: border-box;
  height: 30rpx;
  border: 4rpx solid #ffffff;
  border-radius: 8rpx 8rpx 10rpx 10rpx;
  background: transparent;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  color: #ffffff;
  background: #c45f72;
}

.cart-summary {
  display: flex;
  flex: 1;
  overflow: hidden;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.cart-total {
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #d97986;
}

.cart-hint {
  overflow: hidden;
  font-size: 21rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #847a73;
}

.cart-actions {
  flex: 0 0 auto;
}

.add-button {
  color: #ffffff;
  background: #d97986;
}

.copy-button {
  min-width: 132rpx;
  color: #ffffff;
  background: #d97986;
  box-shadow: 0 8rpx 18rpx rgba(217, 121, 134, 0.18);
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0;
  background: rgba(20, 20, 20, 0.42);
  animation: mask-fade-in 180ms ease-out;
}

.detail-panel {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  width: 100%;
  height: 76vh;
  max-height: 76vh;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 36rpx 36rpx 0 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -18rpx 48rpx rgba(80, 54, 58, 0.18);
  animation: sheet-slide-up 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  transition: transform 180ms ease-out;
}

.detail-drag-zone {
  flex: 0 0 auto;
}

.sheet-drag-area {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  height: 48rpx;
}

.sheet-drag-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e6d9d7;
}

.sheet-header {
  display: flex;
  flex: 0 0 auto;
  gap: 20rpx;
  box-sizing: border-box;
  padding: 0 28rpx 22rpx;
  border-bottom: 1rpx solid #f5ece9;
}

.sheet-thumb {
  flex: 0 0 auto;
  width: 132rpx;
  height: 132rpx;
  border-radius: 22rpx;
  background: #f3e9e5;
}

.detail-scroll {
  flex: 1;
  height: auto;
  min-height: 0;
}

.detail-body {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  padding: 0;
}

.detail-title {
  display: block;
  flex: 1;
  overflow: hidden;
  min-width: 0;
  max-width: 100%;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
  overflow-wrap: break-word;
  word-break: break-all;
  color: #2d2926;
}

.sheet-desc {
  display: block;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  display: -webkit-box;
  overflow-wrap: break-word;
  word-break: break-all;
  color: #847a73;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.detail-tags {
  margin-top: 18rpx;
}

.selected-spec-card {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  margin: 20rpx 28rpx 4rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e8e6e2;
  border-radius: 22rpx;
  background: #ffffff;
}

.selected-spec-label {
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #d97986;
}

.selected-spec-text {
  flex: 1;
  overflow: hidden;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9b8b87;
}

.selected-spec-ready {
  color: #2d2926;
}

.option-section {
  box-sizing: border-box;
  padding: 8rpx 28rpx 24rpx;
}

.option-group {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0eee9;
}

.option-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.option-title {
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #2d2926;
}

.option-required {
  padding: 4rpx 8rpx;
  border-radius: 7rpx;
  font-size: 19rpx;
  line-height: 1.2;
  color: #b96b78;
  background: #f4f3f1;
}

.option-choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 10rpx;
  box-sizing: border-box;
  width: 100%;
  margin-top: 16rpx;
}

.option-input-wrap {
  box-sizing: border-box;
  width: 100%;
  margin-top: 16rpx;
}

.option-input {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx solid #eadbd8;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 64rpx;
  color: #2d2926;
  background: #ffffff;
}

.option-input-placeholder {
  color: #b7a9a3;
}

.option-choice {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  flex: 0 0 auto;
  max-width: 100%;
  min-width: 0;
  min-height: 48rpx;
  padding: 0 16rpx;
  border: 1rpx solid #eadbd8;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 46rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #766a66;
  background: #ffffff;
  transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
}

.option-choice-active {
  border-color: #d97986;
  color: #ffffff;
  background: #d97986;
  box-shadow: 0 8rpx 18rpx rgba(217, 121, 134, 0.18);
}

.option-notice {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: #c45f72;
}

.detail-actions {
  display: flex;
  flex: 0 0 auto;
  box-sizing: border-box;
  padding: 18rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f5ece9;
  background: rgba(255, 255, 255, 0.98);
}

.detail-add {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 80rpx;
  color: #ffffff;
  background: #d97986;
  box-shadow: 0 12rpx 24rpx rgba(217, 121, 134, 0.24);
}

.detail-add-disabled {
  color: rgba(255, 255, 255, 0.78);
  background: #d8cbc8;
  box-shadow: none;
}

@keyframes mask-fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes sheet-slide-up {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 240rpx;
  border: 1rpx dashed #eadbd8;
  border-radius: 22rpx;
  font-size: 26rpx;
  color: #9b8b87;
  background: rgba(255, 255, 255, 0.72);
}

@media (max-width: 360px) {
  .page {
    padding-right: 18rpx;
    padding-left: 18rpx;
  }

  .shop-header,
  .dish-card {
    border-radius: 14rpx;
  }

  .dish-image {
    width: 118rpx;
    height: 118rpx;
  }

  .dish-info {
    min-height: 118rpx;
  }

  .quick-add-button {
    width: 44rpx;
    height: 44rpx;
    min-width: 44rpx;
    min-height: 44rpx;
    font-size: 28rpx;
    line-height: 44rpx;
  }

  .stepper-button {
    width: 38rpx;
    height: 38rpx;
    min-height: 38rpx;
    font-size: 25rpx;
    line-height: 34rpx;
  }

  .card-stepper {
    min-width: 110rpx;
    height: 44rpx;
    gap: 4rpx;
  }

  .card-stepper .stepper-button {
    width: 44rpx;
    height: 44rpx;
    min-height: 44rpx;
    font-size: 25rpx;
    line-height: 40rpx;
  }

  .card-stepper .stepper-count {
    min-width: 18rpx;
    font-size: 20rpx;
  }

  .option-choice-row {
    gap: 10rpx 8rpx;
  }

  .option-input {
    height: 58rpx;
    padding: 0 16rpx;
    font-size: 21rpx;
    line-height: 58rpx;
  }

  .option-choice {
    min-height: 44rpx;
    padding: 0 12rpx;
    font-size: 20rpx;
    line-height: 42rpx;
  }

  .cart-item {
    gap: 8rpx;
    padding: 14rpx;
  }

  .cart-item-image {
    width: 64rpx;
    height: 64rpx;
    border-radius: 10rpx;
  }

  .cart-item-controls {
    flex-basis: 100rpx;
  }

  .cart-stepper {
    gap: 5rpx;
  }

  .cart-stepper .stepper-button {
    width: 36rpx;
    height: 36rpx;
    min-height: 36rpx;
    line-height: 32rpx;
  }

  .cart-remark {
    gap: 10rpx;
    padding: 14rpx 16rpx 16rpx;
  }

  .cart-remark-label {
    font-size: 22rpx;
  }

  .cart-remark-input {
    height: 52rpx;
    padding: 0 14rpx;
    font-size: 21rpx;
    line-height: 52rpx;
  }

  .cart-mask {
    padding-right: 18rpx;
    padding-left: 18rpx;
  }

  .cart-bar {
    right: 18rpx;
    left: 18rpx;
    gap: 10rpx;
    height: 108rpx;
    padding: 12rpx;
  }

  .cart-icon-wrap {
    width: 66rpx;
    height: 66rpx;
  }

  .cart-total {
    font-size: 28rpx;
  }

  .cart-hint {
    font-size: 20rpx;
  }

  .copy-button {
    min-height: 50rpx;
    padding: 0 12rpx;
    font-size: 21rpx;
    line-height: 50rpx;
  }

  .copy-button {
    min-width: 112rpx;
  }
}
