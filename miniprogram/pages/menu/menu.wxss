.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 148rpx;
  background: #f5f6f8;
}

.shop-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #243447 0%, #2f7d6d 100%);
}

.shop-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 12rpx;
}

.shop-name {
  overflow: hidden;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-subtitle {
  font-size: 24rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.82);
}

.share-button {
  flex: 0 0 auto;
  min-width: 156rpx;
  padding: 22rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #21312f;
  background: #ffffff;
}

.content {
  display: flex;
  gap: 20rpx;
  height: calc(100vh - 332rpx);
  min-height: 720rpx;
  margin-top: 24rpx;
}

.category-list {
  width: 168rpx;
  height: 100%;
}

.category-item {
  box-sizing: border-box;
  width: 100%;
  min-height: 86rpx;
  margin-bottom: 14rpx;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.25;
  text-align: center;
  color: #59636f;
  background: #ffffff;
}

.category-item-active {
  color: #ffffff;
  background: #1f7668;
}

.dish-list {
  flex: 1;
  height: 100%;
}

.dish-card {
  display: flex;
  gap: 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 18rpx;
  border: 1rpx solid #e8ecef;
  border-radius: 18rpx;
  background: #ffffff;
}

.dish-image {
  flex: 0 0 auto;
  width: 168rpx;
  height: 168rpx;
  border-radius: 14rpx;
  background: #dfe5e8;
}

.dish-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.dish-title-row,
.detail-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.dish-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
  color: #17212b;
}

.dish-price,
.detail-price {
  flex: 0 0 auto;
  font-size: 28rpx;
  font-weight: 700;
  color: #d55b38;
}

.dish-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  color: #65717d;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tag {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #1f7668;
  background: #e8f4f1;
}

.dish-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: auto;
  padding-top: 16rpx;
}

.ghost-button,
.add-button,
.clear-button,
.disabled-order-button,
.close-button {
  box-sizing: border-box;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 58rpx;
}

.ghost-button,
.close-button {
  color: #334155;
  background: #eef2f4;
}

.add-button {
  color: #ffffff;
  background: #1f7668;
}

.selected-bar {
  position: fixed;
  right: 24rpx;
  bottom: 28rpx;
  left: 24rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  min-height: 104rpx;
  padding: 18rpx 18rpx 18rpx 24rpx;
  border: 1rpx solid #dde4e8;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(28, 39, 49, 0.14);
}

.selected-summary {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.selected-count {
  font-size: 28rpx;
  font-weight: 700;
  color: #16202a;
}

.selected-total {
  font-size: 22rpx;
  color: #687684;
}

.clear-button {
  color: #51606e;
  background: #edf1f3;
}

.disabled-order-button {
  color: #ffffff;
  background: #a55a43;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  background: rgba(11, 18, 24, 0.48);
}

.detail-panel {
  overflow: hidden;
  width: 100%;
  max-height: 86vh;
  border-radius: 24rpx;
  background: #ffffff;
}

.detail-image {
  width: 100%;
  height: 420rpx;
  background: #dfe5e8;
}

.detail-body {
  padding: 28rpx;
}

.detail-title {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
  color: #17212b;
}

.detail-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.55;
  color: #5f6c78;
}

.detail-tags {
  margin-top: 18rpx;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.close-button {
  flex: 1;
}

.detail-add {
  flex: 2;
}
