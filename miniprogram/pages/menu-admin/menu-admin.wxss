page { background: #f7f7f5; color: #383532; }
.page { padding: 32rpx 24rpx 190rpx; }
.heading { font-size: 44rpx; font-weight: 700; }
.heading-row { display: flex; align-items: flex-end; gap: 18rpx; margin-bottom: 28rpx; }
.heading { flex-shrink: 0; }
.subtitle { color: #817b78; font-size: 22rpx; line-height: 1.5; min-width: 0; padding-bottom: 4rpx; }
.panel { background: #fff; border-radius: 24rpx; padding: 24rpx; margin: 20rpx 0; }
.tabs, .row, .actions, .footer { display: flex; align-items: center; gap: 14rpx; }
.tabs { position: relative; background: #eeeae8; border-radius: 18rpx; padding: 8rpx; gap: 0; }
.tab-indicator { position: absolute; left: 8rpx; top: 8rpx; bottom: 8rpx; width: calc((100% - 16rpx) / 4); background: #fff; border-radius: 14rpx; transition: transform 240ms ease; }
button { margin: 0; padding: 0 22rpx; line-height: 76rpx; font-size: 26rpx; background: #f1eeed; border-radius: 16rpx; color: #554d4b; }
button::after { border: 0; }
button[disabled] { opacity: 0.45; }
.tab { position: relative; flex: 1; padding: 0 4rpx; background: transparent; font-size: 24rpx; }
.tab.selected { background: transparent; color: #b95e70; }
.primary { background: #d97a8a; color: white; }
.danger { color: #b14c55; }
.grow { flex: 1; min-width: 0; }
.thumb { width: 104rpx; height: 104rpx; flex-shrink: 0; border-radius: 18rpx; }
.thumb-placeholder { display: flex; align-items: center; justify-content: center; background: #f7f2f0; color: #a69a95; font-size: 20rpx; }
.dish-card { position: relative; }
.dish-card.moving { pointer-events: none; }
.dish-summary { align-items: flex-start; gap: 18rpx; }
.dish-name { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4; }
.dish-description { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-top: 5rpx; }
.dish-status { display: inline-block; color: #ad6574; font-size: 21rpx; margin-top: 5rpx; }
.dish-status.offline { color: #938a84; }
.edit-toggle { flex-shrink: 0; width: auto; min-width: 0; line-height: 60rpx; padding: 0 12rpx; color: #b95e70; background: #fbf0f2; font-size: 24rpx; }
.edit-toggle.is-open { color: #756b66; background: #f1eeed; }
.title { font-size: 30rpx; font-weight: 600; word-break: break-all; }
.muted { font-size: 24rpx; line-height: 1.6; color: #817b78; }
.actions { margin-top: 18rpx; flex-wrap: wrap; }
.actions button { flex: 1; min-width: 0; white-space: nowrap; }
.editor { margin-top: 24rpx; border-top: 1rpx solid #f0ece9; }
.editor-section { padding: 28rpx 0; border-bottom: 1rpx solid #f0ece9; }
.editor-section:last-child { padding-bottom: 0; border-bottom: 0; }
.section-title { font-size: 28rpx; font-weight: 600; color: #65504b; }
.section-hint { margin-top: 16rpx; }
.label { margin: 26rpx 0 12rpx; font-size: 26rpx; font-weight: 500; }
.label-hint { margin-left: 14rpx; color: #938a84; font-size: 23rpx; font-weight: 400; }
input, textarea, .input { box-sizing: border-box; width: 100%; padding: 20rpx; min-height: 80rpx; background: #f7f5f3; border-radius: 14rpx; font-size: 28rpx; }
textarea { min-height: 130rpx; }
.picker-value { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.picker-value text:first-child { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.option { background: #faf7f5; padding: 20rpx; margin: 20rpx 0; border-radius: 18rpx; }
.option .row { margin: 14rpx 0; }
.option .option-heading { margin: 0 0 10rpx; }
.option-type { font-size: 24rpx; color: #8b7770; font-weight: 500; }
.option input { background: #fff; }
.option .label { margin-top: 20rpx; }
.option .choice-row { align-items: center; gap: 10rpx; }
.choice-row input { width: 0; }
.text-action { flex-shrink: 0; padding: 0 12rpx; line-height: 60rpx; font-size: 24rpx; background: transparent; }
.add-choice { width: 100%; margin-top: 12rpx; line-height: 66rpx; color: #a56473; background: #f1e8e6; font-size: 24rpx; }
.option-actions { gap: 12rpx; flex-wrap: nowrap; }
.option-actions button { padding: 0 8rpx; font-size: 24rpx; line-height: 72rpx; }
.dish-image-field { position: relative; width: 100%; margin-top: 20rpx; }
.dish-image-field.is-disabled { pointer-events: none; opacity: .6; }
.image-picker { position: relative; display: block; width: 100%; height: 260rpx; padding: 0; overflow: hidden; background: #f7f3f1; border-radius: 18rpx; }
.editor-image { display: block; width: 100%; height: 100%; }
.image-empty { height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 12rpx; color: #9b817a; font-size: 25rpx; line-height: 1.4; }
.image-add { font-size: 48rpx; line-height: 1; font-weight: 300; }
.image-caption { position: absolute; bottom: 0; left: 0; right: 0; padding: 12rpx; line-height: 1.4; font-size: 23rpx; color: #fff; background: rgba(50, 40, 35, .4); }
/* 锁定控件宽高，叉号不依赖系统字体与按钮默认尺寸。 */
.image-remove { position: absolute; top: 12rpx; left: 12rpx; display: flex; align-items: center; justify-content: center; width: 52rpx; min-width: 52rpx; max-width: 52rpx; height: 52rpx; min-height: 52rpx; max-height: 52rpx; border-radius: 50%; background: rgba(50, 40, 35, .58); }
.cross-line { position: absolute; width: 23rpx; height: 3rpx; border-radius: 2rpx; background: #fff; transform: rotate(45deg); }
.cross-line-alt { transform: rotate(-45deg); }
.wide-image { display: block; width: 100%; height: 220rpx; border-radius: 18rpx; }
.notice { margin: 20rpx 0; padding: 20rpx; background: #fff0e5; color: #885a37; border-radius: 16rpx; font-size: 26rpx; line-height: 1.7; }
.version { word-break: break-all; }
.footer { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -8rpx 30rpx rgba(68,60,56,.06); z-index: 10; }
.footer button { flex: 1; padding: 0 10rpx; }
@media (prefers-reduced-motion: reduce) {
  .dish-card { transition: none !important; transform: none !important; }
}

.header-preview { position: relative; display: flex; align-items: flex-start; gap: 24rpx; box-sizing: border-box; min-height: 188rpx; padding: 36rpx 32rpx; border: 1rpx solid rgba(255,255,255,.5); margin: 0 -24rpx; overflow: hidden; border-radius: 28rpx; background: #ddd8d4; }
.header-preview-image { position: absolute; left: 0; top: 0; width: 100%; height: 100%; max-width: none; }
.header-preview-copy { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12rpx; line-height: 1.45; color: white; font-size: 24rpx; text-shadow: 0 2rpx 8rpx #554d4b; pointer-events: none; }
.header-preview-title { font-size: 44rpx; font-weight: 800; line-height: 1.2; }
.header-drag-hint { position: absolute; bottom: 0; left: 0; right: 0; padding: 12rpx; color: white; background: rgba(50,40,35,.45); font-size: 23rpx; text-align: center; pointer-events: none; }
.header-preview.is-dragging { outline: 4rpx solid #d97a8a; }

.header-preview-gift { position: relative; flex-shrink: 0; box-sizing: border-box; width: 138rpx; min-height: 58rpx; border: 1rpx solid rgba(255,255,255,.56); border-radius: 999rpx; color: white; text-align: center; font-size: 22rpx; line-height: 56rpx; }
@media (max-width: 360px) { .header-preview { gap: 14rpx; padding-left: 24rpx; padding-right: 24rpx; border-radius: 14rpx; } .header-preview-gift { width: 124rpx; min-height: 52rpx; font-size: 20rpx; line-height: 50rpx; } }
