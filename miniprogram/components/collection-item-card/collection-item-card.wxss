.item-card {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  box-sizing: border-box;
  overflow: hidden;
  width: 100%;
  min-height: 184rpx;
  margin-bottom: 18rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(234, 225, 221, 0.72);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 28rpx rgba(109, 84, 78, 0.08);
  transform-origin: center top;
  transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 180ms ease-out;
}

.item-card:active {
  transform: scale(0.992);
  box-shadow: 0 8rpx 20rpx rgba(109, 84, 78, 0.08);
}

.item-card-emphasis {
  animation: item-card-emphasis 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.item-card-removing {
  pointer-events: none;
  animation: item-card-remove 240ms ease-in both;
}

.item-image-wrap {
  position: relative;
  flex: 0 0 auto;
  overflow: hidden;
  width: 164rpx;
  min-height: 152rpx;
  border-radius: 18rpx;
  background: #f3e9e5;
}

.item-image {
  width: 100%;
  height: 100%;
  min-height: 152rpx;
}

.item-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-gift {
  position: relative;
  width: 72rpx;
  height: 70rpx;
}

.placeholder-lid,
.placeholder-box,
.placeholder-ribbon {
  position: absolute;
  box-sizing: border-box;
}

.placeholder-lid {
  top: 12rpx;
  left: 2rpx;
  width: 68rpx;
  height: 20rpx;
  border: 5rpx solid #d99ba4;
  border-radius: 8rpx;
}

.placeholder-box {
  top: 32rpx;
  left: 8rpx;
  width: 56rpx;
  height: 36rpx;
  border: 5rpx solid #d99ba4;
  border-top: 0;
  border-radius: 0 0 9rpx 9rpx;
}

.placeholder-ribbon {
  top: 8rpx;
  left: 31rpx;
  width: 10rpx;
  height: 60rpx;
  border-radius: 4rpx;
  background: #d99ba4;
}

.decor-placeholder {
  background: #eee9df;
}

.placeholder-house {
  position: relative;
  width: 78rpx;
  height: 72rpx;
}

.placeholder-house-roof {
  position: absolute;
  top: -10rpx;
  left: 50%;
  box-sizing: border-box;
  border-width: 0 40rpx 34rpx;
  border-style: solid;
  border-color: transparent transparent #c99b68;
  transform: translateX(-50%);
}

.placeholder-house-body {
  position: absolute;
  top: 24rpx;
  left: 10rpx;
  box-sizing: border-box;
  width: 58rpx;
  height: 44rpx;
  border: 6rpx solid #c99b68;
  border-top: 0;
  border-radius: 0 0 9rpx 9rpx;
}

.placeholder-house-door {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  width: 14rpx;
  height: 25rpx;
  border-radius: 5rpx 5rpx 0 0;
  background: #c99b68;
  transform: translateX(-50%);
}

.item-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  padding: 2rpx 0;
}

.item-title-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  min-width: 0;
}

.item-name {
  display: -webkit-box;
  flex: 1;
  overflow: hidden;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: break-word;
  word-break: break-all;
  color: #2d2926;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.item-date {
  flex: 0 0 auto;
  font-size: 19rpx;
  line-height: 1.45;
  color: #b09f99;
}

.item-description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 9rpx;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  overflow-wrap: break-word;
  word-break: break-all;
  color: #847a73;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.item-edit-hint {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  margin-top: auto;
  padding-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #a58f89;
}

.item-edit-arrow {
  font-size: 30rpx;
  line-height: 20rpx;
}

@keyframes item-card-emphasis {
  0% {
    opacity: 0.82;
    transform: translateY(10rpx) scale(0.985);
  }

  68% {
    opacity: 1;
    transform: translateY(0) scale(1.012);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes item-card-remove {
  from {
    opacity: 1;
    max-height: 600rpx;
    margin-bottom: 18rpx;
    padding-top: 16rpx;
    padding-bottom: 16rpx;
    transform: scale(1);
  }

  to {
    opacity: 0;
    max-height: 0;
    min-height: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-width: 0;
    transform: scale(0.98);
  }
}

@media (prefers-reduced-motion: reduce) {
  .item-card,
  .item-card-emphasis,
  .item-card-removing {
    animation: none;
    transition: none;
  }
}

@media (max-width: 360px) {
  .item-card {
    border-radius: 14rpx;
  }

  .item-image-wrap {
    width: 138rpx;
  }
}
