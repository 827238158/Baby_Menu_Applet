{
  "description": "Project lifecycle hooks with lightweight memory retrieval and review.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -B \"$(git rev-parse --show-toplevel)/.codex/hooks/memory_router.py\"",
            "commandWindows": "D:\\Anaconda\\python.exe -X utf8 -B G:\\BackUp\\AI+网络项目孵化\\Baby_Menu_Applet\\.codex\\hooks\\memory_router.py",
            "statusMessage": "Retrieving relevant project memory",
            "timeout": 10,
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -B \"$(git rev-parse --show-toplevel)/.codex/hooks/memory_gate.py\"",
            "commandWindows": "D:\\Anaconda\\python.exe -X utf8 -B G:\\BackUp\\AI+网络项目孵化\\Baby_Menu_Applet\\.codex\\hooks\\memory_gate.py",
            "statusMessage": "Checking project memory updates",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -B \"$(git rev-parse --show-toplevel)/.codex/hooks/memory_signal_collector.py\"",
            "commandWindows": "D:\\Anaconda\\python.exe -X utf8 -B G:\\BackUp\\AI+网络项目孵化\\Baby_Menu_Applet\\.codex\\hooks\\memory_signal_collector.py",
            "statusMessage": "Collecting high-signal failure clues",
            "timeout": 5
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
